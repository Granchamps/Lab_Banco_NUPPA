-- Preço medio por grupo alimentar

SELECT
    g.grp_nome AS GRUPO,
    ROUND(AVG(c.cot_prc_med), 2) AS PREC_MEDIO
FROM COTACAO c
JOIN PRODUTO_APRESENTACAO pa
    ON pa.pap_id = c.cot_pap_id
JOIN PRODUTO p
    ON p.prd_id = pa.pap_prd_id
JOIN CATEGORIA cat
    ON cat.cat_id = p.prd_cat_id
JOIN GRUPO_ALIMENTAR g
    ON g.grp_id = cat.cat_grp_id
GROUP BY g.grp_nome
ORDER BY PRECO_MEDIO DESC;

-- Comparação entre preço atual e média histórica

SELECT
    p.prd_nome AS PRODUTO,
    ROUND(AVG(h.hcot_prc_med),2) AS
    MEDIA_HISTORICA,
    ROUND(AVG(c.cot_prd_med),2) AS
    MEDIA_ATUAL,
    ROUND(AVG(c.cot_prc_med) - AVG(h.hcot_prc_med),2)
    AS VARIACAO
    FROM COTACAO c
    JOIN H_COTACAO h
    ON h.hcot_pap_id = c.cot_pap_id
    JOIN PRODUTO_APRESENTACAO pa
    ON pa.pap_id = c.cot_pap_id
    JOIN PRODUTO p
    ON p.prd_id = pa.pap_prd_id
    GROUP BY p.prd_nome
    ORDER BY VARIACAO DESC;