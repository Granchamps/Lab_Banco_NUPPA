  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"  ENABLE
--------------------------------------------------------
--  Constraints for Table COTACAO
--------------------------------------------------------

  ALTER TABLE "SYSTEM"."COTACAO" MODIFY ("COT_ID" CONSTRAINT "CK_COT_NN_01" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."COTACAO" MODIFY ("COT_BLT_ID" CONSTRAINT "CK_COT_NN_02" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."COTACAO" MODIFY ("COT_PAP_ID" CONSTRAINT "CK_COT_NN_03" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."COTACAO" ADD CONSTRAINT "CK_COT_PRC" CHECK (
    (cot_prc_comum IS NULL OR cot_prc_comum >= 0)
    AND (cot_prc_min IS NULL OR cot_prc_min >= 0)
    AND (cot_prc_max IS NULL OR cot_prc_max >= 0)
    AND (cot_prc_med IS NULL OR cot_prc_med >= 0)
    AND (cot_prc_mediana IS NULL OR cot_prc_mediana >= 0)

    AND (
        cot_prc_max IS NULL
        OR cot_prc_min IS NULL
        OR cot_prc_max >= cot_prc_min
    )

    AND (
        cot_prc_med IS NULL
        OR cot_prc_min IS NULL
        OR cot_prc_med >= cot_prc_min
    )

    AND (
        cot_prc_med IS NULL
        OR cot_prc_max IS NULL
        OR cot_prc_med <= cot_prc_max
    )

    AND (
        cot_prc_mediana IS NULL
        OR cot_prc_min IS NULL
        OR cot_prc_mediana >= cot_prc_min
    )

    AND (
        cot_prc_mediana IS NULL
        OR cot_prc_max IS NULL
        OR cot_prc_mediana <= cot_prc_max
    )
) ENABLE
  ALTER TABLE "SYSTEM"."COTACAO" ADD CONSTRAINT "PK_COT" PRIMARY KEY ("COT_ID")
  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"  ENABLE
