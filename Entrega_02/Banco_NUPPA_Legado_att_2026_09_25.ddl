  CREATE TABLE "SYSTEM"."PRODUTO_APRESENTACAO" 
   (	"PAP_ID" NUMBER(6,0) CONSTRAINT "CK_PAP_NN_01" NOT NULL ENABLE, 
	"PAP_PRD_ID" NUMBER(6,0) CONSTRAINT "CK_PAP_NN_02" NOT NULL ENABLE, 
	"PAP_TAP_ID" NUMBER(6,0) CONSTRAINT "CK_PAP_NN_03" NOT NULL ENABLE, 
	"PAP_QTD" NUMBER(6,0), 
	"PAP_UMD_ID" NUMBER(6,0), 
	"PAP_ATV" NUMBER CONSTRAINT "CK_PAP_NN_05" NOT NULL ENABLE, 
	 CONSTRAINT "CK_PAP_ATV" CHECK (pap_atv in (0,1)) ENABLE, 
	 CONSTRAINT "PK_PAP" PRIMARY KEY ("PAP_ID")
  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"  ENABLE, 
	 CONSTRAINT "FK_PAP_PRD" FOREIGN KEY ("PAP_PRD_ID")
	  REFERENCES "SYSTEM"."PRODUTO" ("PRD_ID") ENABLE, 
	 CONSTRAINT "FK_PAP_TAP" FOREIGN KEY ("PAP_TAP_ID")
	  REFERENCES "SYSTEM"."TIPO_APRESENTACAO" ("TAP_ID") ENABLE, 
	 CONSTRAINT "FK_PAP_UMD" FOREIGN KEY ("PAP_UMD_ID")
	  REFERENCES "SYSTEM"."UNIDADE_MEDIDA" ("UMD_ID") ENABLE
   ) PCTFREE 10 PCTUSED 40 INITRANS 1 MAXTRANS 255 
 NOCOMPRESS LOGGING
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"
--------------------------------------------------------
--  DDL for Table TIPO_APRESENTACAO
--------------------------------------------------------

  CREATE TABLE "SYSTEM"."TIPO_APRESENTACAO" 
   (	"TAP_ID" NUMBER(6,0) CONSTRAINT "CK_TAP_NN_01" NOT NULL ENABLE, 
	"TAP_NOME" VARCHAR2(50) CONSTRAINT "CK_TAP_NN_02" NOT NULL ENABLE, 
	 CONSTRAINT "PK_TAP" PRIMARY KEY ("TAP_ID")
  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"  ENABLE
   ) PCTFREE 10 PCTUSED 40 INITRANS 1 MAXTRANS 255 
 NOCOMPRESS LOGGING
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM" 

   COMMENT ON COLUMN "SYSTEM"."TIPO_APRESENTACAO"."TAP_NOME" IS 'caixa, duzia, maço, etc'
--------------------------------------------------------
--  DDL for Table UNIDADE_MEDIDA
--------------------------------------------------------

  CREATE TABLE "SYSTEM"."UNIDADE_MEDIDA" 
   (	"UMD_ID" NUMBER(6,0) CONSTRAINT "CK_UMD_NN_01" NOT NULL ENABLE, 
	"UMD_NOME" VARCHAR2(50) CONSTRAINT "CK_UMD_NN_02" NOT NULL ENABLE, 
	"UMD_SIGLA" VARCHAR2(10) CONSTRAINT "CK_UMD_NN_03" NOT NULL ENABLE, 
	 CONSTRAINT "PK_UMD" PRIMARY KEY ("UMD_ID")
  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"  ENABLE
   ) PCTFREE 10 PCTUSED 40 INITRANS 1 MAXTRANS 255 
 NOCOMPRESS LOGGING
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"
