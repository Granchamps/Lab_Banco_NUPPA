--  Constraints for Table BOLETIM
--------------------------------------------------------

  ALTER TABLE "SYSTEM"."BOLETIM" MODIFY ("BLT_ID" CONSTRAINT "CK_BLT_NN_01" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."BOLETIM" MODIFY ("BLT_NUMERO" CONSTRAINT "CK_BLT_NN_02" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."BOLETIM" MODIFY ("BLT_ANO" CONSTRAINT "CK_BLT_NN_03" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."BOLETIM" MODIFY ("BLT_DATA_LEV" CONSTRAINT "CK_BLT_NN_04" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."BOLETIM" ADD CONSTRAINT "PK_BLT" PRIMARY KEY ("BLT_ID")
  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"  ENABLE
  ALTER TABLE "SYSTEM"."BOLETIM" ADD CONSTRAINT "UK_BLT_NUM_ANO" UNIQUE ("BLT_NUMERO", "BLT_ANO")
  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"  ENABLE
