--------------------------------------------------------

  ALTER TABLE "SYSTEM"."CATEGORIA" MODIFY ("CAT_ID" CONSTRAINT "CK_CAT_NN_01" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."CATEGORIA" MODIFY ("CAT_GRP_ID" CONSTRAINT "CK_CAT_NN_02" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."CATEGORIA" MODIFY ("CAT_NOME" CONSTRAINT "CK_CAT_NN_03" NOT NULL ENABLE)
  ALTER TABLE "SYSTEM"."CATEGORIA" ADD CONSTRAINT "PK_CAT" PRIMARY KEY ("CAT_ID")
  USING INDEX PCTFREE 10 INITRANS 2 MAXTRANS 255 COMPUTE STATISTICS 
  STORAGE(INITIAL 65536 NEXT 1048576 MINEXTENTS 1 MAXEXTENTS 2147483645
  PCTINCREASE 0 FREELISTS 1 FREELIST GROUPS 1
  BUFFER_POOL DEFAULT FLASH_CACHE DEFAULT CELL_FLASH_CACHE DEFAULT)
  TABLESPACE "SYSTEM"  ENABLE
